---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>
    <h1>Lista de productos usando CSR</h1>
    <p> Fecha y hora <span id="fechahora"></span></p>
    <ul id="lista">    </ul>
</BaseLayout>

<script>
    function cargarDatos(){
        const productos = ['Falda', 'Pantalon', 'Calcetines']
        const lista = document.getElementById('lista')
        productos.forEach(p => {
            const li = document.createElement('li')
            lista?.appendChild(li)
            li.textContent = p
        })
        const fechahora = document.getElementById('fechahora');
        if (fechahora) {
            fechahora.textContent = new Date().toLocaleString('es-ES');
        }
    }
    document.addEventListener('astro:page-load', cargarDatos);
</script>